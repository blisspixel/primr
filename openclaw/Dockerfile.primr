# Dockerfile for Primr MCP Server in Open Claw sandbox
#
# Security requirements: SR-3.1, SR-3.2, SR-3.3, SR-3.4
# - Non-root user execution
# - No host credentials mounted
# - Output directory read-write
# - Documentation read-only

FROM python:3.12-slim@sha256:423ed6ab25b1921a477529254bfeeabf5855151dc2c3141699a1bfc852199fbf AS builder

WORKDIR /build

COPY deploy/build-requirements.lock /build/build-requirements.lock
RUN pip install --no-cache-dir --require-hashes -r /build/build-requirements.lock

COPY pyproject.toml .
COPY MANIFEST.in .
COPY README.md .
COPY src/ src/

RUN python -m build --wheel --no-isolation --outdir /build/dist

FROM python:3.12-slim@sha256:423ed6ab25b1921a477529254bfeeabf5855151dc2c3141699a1bfc852199fbf

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user (SR-3.1)
RUN useradd -m -s /bin/bash -u 1000 primr

# Set working directory
WORKDIR /workspace

# Copy the local project wheel and exact dependency inputs while still root.
COPY --chown=primr:primr --from=builder /build/dist/*.whl /workspace/
COPY --chown=primr:primr deploy/build-requirements.lock /workspace/build-requirements.lock
COPY --chown=primr:primr deploy/runtime-requirements.lock /workspace/runtime-requirements.lock

# Create the writable output directory before dropping privileges.
RUN mkdir -p /workspace/output && chown -R primr:primr /workspace

# Switch to non-root user before installing packages
USER primr

# Add local bin to PATH for pip --user installs
ENV PATH="/home/primr/.local/bin:${PATH}"

# Install exact hash-verified dependencies and the locally built project wheel.
RUN pip install --no-cache-dir --require-hashes --user \
        -r /workspace/build-requirements.lock && \
    pip install --no-cache-dir --require-hashes --no-build-isolation --user \
        -r /workspace/runtime-requirements.lock && \
    pip install --no-cache-dir --no-deps --user /workspace/*.whl && \
    rm /workspace/*.whl /workspace/build-requirements.lock \
        /workspace/runtime-requirements.lock

# Secret API keys (XAI_API_KEY, GEMINI_API_KEY, SEARCH_API_KEY, SEARCH_ENGINE_ID)
# are NOT declared here — pass them at runtime (`docker run -e XAI_API_KEY=...`
# or a secrets mount). Declaring them as ENV, even empty, bakes secret-named
# vars into image layers (Trivy DS-0031) and serves no purpose, since the app
# reads them from the runtime environment regardless.
ENV PRIMR_OUTPUT_DIR="/workspace/output"

# Health check using primr doctor
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD primr doctor || exit 1

# Expose no ports - stdio transport only
# No EXPOSE directive needed

# Set entrypoint to primr-mcp with stdio transport
ENTRYPOINT ["primr-mcp", "--stdio"]

# Labels for documentation
ARG PRIMR_VERSION=1.39.4
LABEL org.opencontainers.image.title="Primr MCP Server"
LABEL org.opencontainers.image.description="Primr company research tool for Open Claw integration"
LABEL org.opencontainers.image.version="${PRIMR_VERSION}"
LABEL org.opencontainers.image.vendor="Primr"
LABEL org.opencontainers.image.source="https://github.com/primr/primr"
LABEL openclaw.sandbox.network="host"
LABEL openclaw.sandbox.user="primr"
