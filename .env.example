# Primr Environment Configuration
# Copy this file to .env and fill in your API keys

# Required: Google Gemini API key
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Google Custom Search API key
# Get yours at: https://console.cloud.google.com/apis/credentials
SEARCH_API_KEY=your_search_api_key_here

# Required: Google Custom Search Engine ID
# Create one at: https://programmablesearchengine.google.com/
SEARCH_ENGINE_ID=your_search_engine_id_here

# Optional: Override default models
# AI_FAST_MODEL=gemini-3-flash-preview
# AI_REASONING_MODEL=gemini-3-pro-preview

# Optional: Enable verbose output
# VERBOSE=true
