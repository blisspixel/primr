# Primr Environment Configuration
# Prefer `primr init` or `primr keys set ...` for user-level setup.
# `primr init` creates/updates config; edit .env directly only for project-specific overrides.

# Required: Google Gemini API key for Gemini-backed stages and premium mode
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY = your_gemini_api_key_here

# Recommended: xAI API key for the default Grok standard pipeline
# Get yours at: https://console.x.ai/
# XAI_API_KEY=<your-xai-api-key>

# Optional: OpenAI API key — unlocks GPT-5.5 / GPT-5.4 / o-series for the cross-provider eval and routing
# Get yours at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=<your-openai-api-key>

# Optional: Anthropic API key — unlocks Claude Opus / Sonnet / Haiku for the cross-provider eval and routing
# Get yours at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Optional: Ollama base URL — local inference, zero marginal cost (defaults to http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: OpenAI-compatible endpoint for local/self-hosted or gateway inference.
# Takes precedence over OLLAMA_BASE_URL for the local/eval and utility paths.
# Point this at vLLM, LM Studio, an Azure AI Foundry / Bedrock OpenAI-compatible
# gateway, or any OpenAI-compatible server. Pair with LOCAL_LLM_API_KEY if the
# endpoint requires one.
# LOCAL_LLM_BASE_URL=http://localhost:8000/v1
# LOCAL_LLM_API_KEY=<token-if-required>

# Optional: Microsoft Foundry / Azure OpenAI (OpenAI-compatible /openai/v1/).
# Unlocks Phi-4 (ultra-cheap reasoning), GPT, Llama, DeepSeek on Azure.
# Set the key plus either the full base URL or the resource endpoint.
# AZURE_OPENAI_API_KEY=<your-azure-openai-key>
# AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com

# Optional: Amazon Bedrock (Claude, Nova, Llama, Gemma, DeepSeek via converse).
# Needs `pip install 'primr[bedrock]'`. Authenticate with a Bedrock API key OR
# the standard AWS credential chain; a region is always required.
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=<bedrock-api-key>
# AWS_ACCESS_KEY_ID=<your-access-key>
# AWS_SECRET_ACCESS_KEY=<your-secret-key>
# AWS_PROFILE=<named-profile-instead-of-keys>

# =============================================================================
# Cost opt-ins
# =============================================================================

# Optional: allow stale or missing vendor research cache to trigger fresh Deep Research.
# Off by default so strategy enrichment reuses cache without hidden refresh spend.
# PRIMR_ALLOW_VENDOR_REFRESH=0

# Optional: allow Gemini-backed PDF extraction during scraping.
# Default is 0, which uses local PyMuPDF extraction only.
# PRIMR_PDF_LLM_MAX_CALLS=0

# =============================================================================
# Search Provider (optional — DuckDuckGo is used by default, no key needed)
# =============================================================================

# SEARCH_PROVIDER controls which search engine Primr uses:
#   "auto" (default) = DuckDuckGo (no API key required)
#   "ddg"            = DuckDuckGo explicitly
#   "google"         = Google Custom Search (requires keys below)
# SEARCH_PROVIDER=auto

# Optional: Google Custom Search API (only needed if SEARCH_PROVIDER=google)
# SEARCH_API_KEY=your_search_api_key_here
# SEARCH_ENGINE_ID=your_search_engine_id_here

# Optional: Override default models (defaults: gemini-3-flash-preview / gemini-3.1-pro-preview).
# AI_FAST_MODEL drives the cheap utility/writing tier; AI_REASONING_MODEL drives
# strategy/analysis. Point these at cheaper or newer models to tune the ~$1 default.
# AI_FAST_MODEL=gemini-3-flash-preview
# AI_REASONING_MODEL=gemini-3.1-pro-preview
# Cheaper writing tier (sub-$1 candidate): gemini-3.1-flash-lite ($0.25/$1.50)
# AI_FAST_MODEL=gemini-3.1-flash-lite
# Stronger reasoning at a lower price than 3.1 Pro: gemini-3.5-flash ($1.50/$9)
# AI_REASONING_MODEL=gemini-3.5-flash

# Optional: Enable verbose output
# VERBOSE=true

# =============================================================================
# MCP Server Authentication (HTTP mode only)
# =============================================================================

# Static admin tokens (comma-separated) - for simple deployments
# MCP_ADMIN_TOKENS=token1,token2

# JWT authentication - for production deployments
# Secret key for JWT signature verification (minimum 32 characters recommended)
# MCP_JWT_SECRET=your-secret-key-minimum-32-characters

# Optional: Validate JWT issuer claim
# MCP_JWT_ISSUER=your-issuer

# Optional: Validate JWT audience claim
# MCP_JWT_AUDIENCE=your-audience

# =============================================================================
# REST API Configuration
# =============================================================================

# CORS allowed origins (comma-separated) - defaults to localhost only
# PRIMR_CORS_ORIGINS=https://your-frontend.com,https://admin.your-domain.com
