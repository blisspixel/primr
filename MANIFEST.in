# Include documentation
include README.md
include docs/CHANGELOG.md
include ROADMAP.md
include LICENSE

# Include configuration files
include pyproject.toml
include mypy.ini
include .env.example

# Include documentation directory
recursive-include docs *.md
recursive-include docs/images *.png

# Include portable host-agent skills and Claude plugin packaging
recursive-include .agents *.md *.yaml
recursive-include claude-code *.md *.json *.yaml

# Include type stubs
include src/primr/py.typed

# Exclude development and test files
recursive-exclude tests *
prune .agent
prune docs/.agent
